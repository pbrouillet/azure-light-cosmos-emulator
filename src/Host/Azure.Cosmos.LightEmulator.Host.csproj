<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC uses less memory than Server GC, better for an emulator -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Set to true to skip the Explorer SPA build (e.g. in CI when unchanged, or test projects) -->
    <SkipExplorerBuild Condition="'$(SkipExplorerBuild)' == ''">false</SkipExplorerBuild>
    <ExplorerDir>$(MSBuildThisFileDirectory)..\Explorer</ExplorerDir>
  </PropertyGroup>

  <!-- Build the Explorer React SPA before the .NET compile so wwwroot/explorer/ is fresh.
       Uses a stamp file to avoid rebuilding when Explorer sources haven't changed.
       The stamp is invalidated when any .ts/.tsx/.json/.html file under src/Explorer/src changes.
       Pass -p:SkipExplorerBuild=true to skip entirely. -->
  <Target Name="BuildExplorerSpa"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipExplorerBuild)' != 'true'"
          Inputs="$(ExplorerDir)\package.json;$(ExplorerDir)\index.html;$(ExplorerDir)\vite.config.ts;$(ExplorerDir)\tsconfig.json;$(ExplorerDir)\tsconfig.app.json;@(ExplorerSources)"
          Outputs="$(BaseIntermediateOutputPath)explorer.build.stamp">
    <Message Importance="high" Text="Building Explorer SPA..." />
    <Exec Command="npm install --prefer-offline --no-audit" WorkingDirectory="$(ExplorerDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(ExplorerDir)" />
    <Touch Files="$(BaseIntermediateOutputPath)explorer.build.stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup Condition="'$(SkipExplorerBuild)' != 'true'">
    <ExplorerSources Include="$(ExplorerDir)\src\**\*.ts;$(ExplorerDir)\src\**\*.tsx;$(ExplorerDir)\src\**\*.css" />
  </ItemGroup>

  <!-- In Release configuration, embed Explorer assets for single-file publishing -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <EmbeddedResource Include="wwwroot\explorer\**" />
  </ItemGroup>

  <!-- Copy explorer SPA to build output so it's accessible regardless of content root.
       In Release configuration, the assets are embedded via the EmbeddedResource rule
       above and Program.cs.ResolveExplorerFileProvider tries the embedded provider
       first, so loose-copying them to the publish output is dead weight. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <Content Update="wwwroot\explorer\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Azure.Cosmos.LightEmulator.Core.csproj" />
    <ProjectReference Include="..\Storage\Azure.Cosmos.LightEmulator.Storage.csproj" />
    <ProjectReference Include="..\Auth\Azure.Cosmos.LightEmulator.Auth.csproj" />
    <ProjectReference Include="..\NoSql\Azure.Cosmos.LightEmulator.NoSql.csproj" />
    <ProjectReference Include="..\MongoDB\Azure.Cosmos.LightEmulator.MongoDB.csproj" />
    <ProjectReference Include="..\Triggers\Azure.Cosmos.LightEmulator.Triggers.csproj" />
    <ProjectReference Include="..\Kql\Azure.Cosmos.LightEmulator.Kql.csproj" />
  </ItemGroup>

</Project>
