<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cosmos-emulator</ToolCommandName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Track the icon so msbuild rebuilds the Win32 resource when it changes. -->
    <None Include="..\..\assets\icon.ico" Link="icon.ico" />
  </ItemGroup>

  <!-- Single-file publish settings.
       These properties only take effect during 'dotnet publish'.
       SelfContained is passed via command line to avoid NETSDK1150 during build.
       Trimming is disabled because the emulator's deep dependency chains
       (SurrealDb → Dahomey.Cbor, Jint, Quartz) rely heavily on reflection
       and cannot survive TrimMode=full even with extensive TrimmerRootAssembly entries. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Host\Azure.Cosmos.LightEmulator.Host.csproj" />
  </ItemGroup>

</Project>
