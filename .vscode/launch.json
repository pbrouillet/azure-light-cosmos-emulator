{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI (start)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "cargo build",
      "program": "${workspaceFolder}/target/debug/cosmos-emulator",
      "args": ["start"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug CLI (start, in-memory)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "cargo build",
      "program": "${workspaceFolder}/target/debug/cosmos-emulator",
      "args": ["start", "--storage", "in-memory"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
