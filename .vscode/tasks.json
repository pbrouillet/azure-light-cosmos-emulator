{
  "version": "2.0.0",
  "tasks": [
    // ── Build ──────────────────────────────────────────────
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Azure.Cosmos.LightEmulator.slnx",
        "-p:SkipExplorerBuild=true",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-explorer",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/src/Explorer"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-cli",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Cli/Azure.Cosmos.LightEmulator.Cli.csproj",
        "-p:SkipExplorerBuild=true",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-explorer-and-cli",
      "dependsOn": ["build-explorer", "build-cli"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    // ── Test — All ─────────────────────────────────────────
    {
      "label": "test-all",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Azure.Cosmos.LightEmulator.slnx",
        "--verbosity", "normal",
        "-p:SkipCloneSdkTests=true"
      ],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── Test — Unit (Core, Auth, Storage, MongoDB, Kql) ───
    {
      "label": "test-unit",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Azure.Cosmos.LightEmulator.slnx",
        "--verbosity", "normal",
        "--filter", "FullyQualifiedName~Core.Tests|FullyQualifiedName~Auth.Tests|FullyQualifiedName~Storage.Tests|FullyQualifiedName~MongoDB.Tests|FullyQualifiedName~Kql.Tests"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── Test — Integration (NoSql.Tests, Host.Tests) ──────
    {
      "label": "test-integration",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Azure.Cosmos.LightEmulator.slnx",
        "--verbosity", "normal",
        "--filter", "FullyQualifiedName~NoSql.Tests|FullyQualifiedName~Host.Tests"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── Test — Parity / SDK smoke tests ───────────────────
    {
      "label": "test-parity",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/Parity",
        "--verbosity", "normal",
        "-p:SkipCloneSdkTests=true"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    // ── Lint — Explorer SPA ───────────────────────────────
    {
      "label": "lint-explorer",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/src/Explorer"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    // ── Dev — Explorer hot-reload server ──────────────────
    {
      "label": "dev-explorer",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/src/Explorer"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
