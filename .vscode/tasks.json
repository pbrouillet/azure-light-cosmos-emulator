{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-explorer",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/src/Explorer"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build-cli",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Cli/Azure.Cosmos.LightEmulator.Cli.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary;ForceNoAlign"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-explorer-and-cli",
      "dependsOn": ["build-explorer", "build-cli"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
