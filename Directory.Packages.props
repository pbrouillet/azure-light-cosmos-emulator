<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- SurrealDB -->
    <PackageVersion Include="SurrealDb.Embedded.RocksDb" Version="1.0.0" />
    <PackageVersion Include="SurrealDb.Net" Version="1.0.0" />
    <!-- JavaScript Runtime -->
    <PackageVersion Include="Jint" Version="4.15.3" />
    <!-- Scheduling -->
    <PackageVersion Include="Quartz" Version="3.19.1" />
    <!-- Query Parsing -->
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <!-- KQL Parsing -->
    <PackageVersion Include="Microsoft.Azure.Kusto.Language" Version="12.4.1" />
    <!-- SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Spatial / Geospatial -->
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <!-- Vector search (HNSW ANN) -->
    <PackageVersion Include="HNSW" Version="26.6.1848" />
    <!-- Transitive pin: HNSW pulls MessagePack 3.1.0 (NU1902, GHSA-wfr3-xj75-pfwh); 3.1.8 is patched -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <!-- Authentication -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <!-- Transitive pin: address NU1903 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) in 9.0.0 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- MongoDB Wire Protocol -->
    <PackageVersion Include="MongoDB.Bson" Version="3.10.0" />
    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <!-- ASP.NET & Hosting -->
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.62.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>
</Project>