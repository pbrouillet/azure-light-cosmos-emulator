<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- SurrealDB -->
    <PackageVersion Include="SurrealDb.Embedded.RocksDb" Version="0.9.0" />
    <PackageVersion Include="SurrealDb.Net" Version="0.9.0" />
    <!-- JavaScript Runtime -->
    <PackageVersion Include="Jint" Version="4.2.1" />
    <!-- Scheduling -->
    <PackageVersion Include="Quartz" Version="3.14.0" />
    <!-- Query Parsing -->
    <PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <!-- KQL Parsing -->
    <PackageVersion Include="Microsoft.Azure.Kusto.Language" Version="12.3.2" />
    <!-- SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Spatial / Geospatial -->
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <!-- Authentication -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.8.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <!-- Transitive pin: address NU1903 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) in 9.0.0 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.6" />
    <!-- MongoDB Wire Protocol -->
    <PackageVersion Include="MongoDB.Bson" Version="3.4.0" />
    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
    <!-- ASP.NET & Hosting -->
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="8.2.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.49.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.52.0" />
  </ItemGroup>
</Project>